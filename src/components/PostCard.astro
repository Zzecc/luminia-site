---
interface Props {
	title: string;
	excerpt?: string;
	href: string;
	date?: Date;
	typeLabel?: string;
	tags?: string[];
}

const { title, excerpt, href, date, typeLabel, tags } = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
	: null;
---

<article class="post-item">
	<a href={href} class="post-link">
		<div class="post-meta">
			{typeLabel && <span class="type-badge">{typeLabel}</span>}
			{formattedDate && <time class="post-date">{formattedDate}</time>}
		</div>
		<h2 class="post-title">{title}</h2>
		{excerpt && <p class="post-excerpt">{excerpt}</p>}
	</a>
	{
		tags && tags.length > 0 && (
			<div class="post-tags">
				{tags.map((t) => (
					<span class="post-tag">{t}</span>
				))}
			</div>
		)
	}
</article>

<style>
	.post-item {
		padding: var(--spacing-xl) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-sm);
	}

	.type-badge {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
		font-weight: 600;
	}

	.post-date {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		margin-top: var(--spacing-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
	}

	.post-tag {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		padding: 2px var(--spacing-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}
</style>
