---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}

const { title, description, image, type = "website" } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Estudio";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "Diseño y desarrollo";
const siteLogo = (settings?.logo as any)?.url ? settings.logo as
	{ mediaId: string; alt?: string; url: string } : null;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link
			href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=general-sans@400,500,600&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="nav-frame">
				<nav class="nav">
					<a href="/" class="brand">
						<span class="brand-corners" aria-hidden="true">
							<i></i><i></i><i></i><i></i>
						</span>
						{siteLogo
							? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
							: <span class="brand-mark">{siteTitle}.</span>
						}
					</a>
					<div class="nav-links">
						{
							menu?.items.map((item) => (
								<a href={item.url} target={item.target} class="nav-link">
									{item.label}
								</a>
							))
						}
						<a href="/_emdash/admin" class="nav-link nav-admin">Panel</a>
					</div>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-frame">
				<div class="footer-content">
					<div class="footer-cell footer-brand">
						<span class="footer-logo">
							{siteLogo
								? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="footer-logo-img" />
								: siteTitle
							}
						</span>
						<p class="footer-tagline">
							{settings?.tagline || "Diseño y desarrollo"}
						</p>
					</div>
					<div class="footer-cell footer-theme">
						<span class="footer-label">Tema</span>
						<div class="theme-switcher">
							<button
								type="button"
								class="theme-btn"
								data-theme="light"
								aria-label="Modo claro">Claro</button
							>
							<button
								type="button"
								class="theme-btn"
								data-theme="dark"
								aria-label="Modo oscuro">Oscuro</button
							>
							<button
								type="button"
								class="theme-btn"
								data-theme="system"
								aria-label="Tema del sistema">Sistema</button
							>
						</div>
					</div>
					<div class="footer-cell footer-powered">
						<span class="footer-label">Powered by</span>
						<a href="https://emdashcms.com">EmDash</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setTheme(theme: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.classList.toggle("active", btn.dataset.theme === theme);
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize - apply stored theme on load
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a {
					color: currentColor;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
				}

				h1,
				h2 {
					text-transform: uppercase;
					color: var(--color-brand);
					letter-spacing: var(--tracking-tight);
				}

				h1 {
					font-size: var(--font-size-4xl);
				}

				h2 {
					font-size: var(--font-size-2xl);
				}

				h3 {
					font-size: var(--font-size-xl);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 20;
				background: var(--color-bg);
			}

			.nav-frame {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 var(--spacing-lg);
				border-inline: 1px dashed var(--color-border);
				border-bottom: 1px dashed var(--color-border);
			}

			.nav {
				display: flex;
				align-items: stretch;
			}

			.brand {
				position: relative;
				display: flex;
				align-items: center;
				gap: var(--spacing-sm);
				padding: var(--spacing-md) var(--spacing-sm) var(--spacing-md) 0;
				text-decoration: none;
			}

			.brand-mark {
				font-family: var(--font-heading);
				font-size: var(--font-size-base);
				font-weight: var(--font-weight-heading);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				color: var(--color-brand);
			}

			.brand-corners {
				position: absolute;
				inset: 4px 4px 4px -8px;
				pointer-events: none;
			}

			.brand-corners i {
				position: absolute;
				width: 5px;
				height: 5px;
				border-color: var(--color-brand);
				border-style: solid;
				opacity: 0.5;
				transition: all var(--transition-base);
			}

			.brand-corners i:nth-child(1) {
				top: 0;
				left: 0;
				border-width: 1px 0 0 1px;
			}

			.brand-corners i:nth-child(2) {
				top: 0;
				right: 0;
				border-width: 1px 1px 0 0;
			}

			.brand-corners i:nth-child(3) {
				bottom: 0;
				left: 0;
				border-width: 0 0 1px 1px;
			}

			.brand-corners i:nth-child(4) {
				bottom: 0;
				right: 0;
				border-width: 0 1px 1px 0;
			}

			.brand:hover .brand-corners i {
				opacity: 1;
				width: 8px;
				height: 8px;
			}

			.site-logo-img {
				height: 40px;
				width: auto;
				display: block;
			}

			.nav-links {
				display: flex;
				align-items: stretch;
				margin-left: auto;
				border-left: 1px dashed var(--color-border);
			}

			.nav-link {
				display: flex;
				align-items: center;
				padding: var(--spacing-md) var(--spacing-md);
				font-size: var(--font-size-xs);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				text-decoration: none;
				color: var(--color-brand);
				border-right: 1px dashed var(--color-border);
				transition: background var(--transition-fast);
				white-space: nowrap;
			}

			.nav-link:hover {
				background: var(--color-surface);
			}

			.nav-link:empty {
				display: none;
			}

			.nav-admin {
				color: var(--color-muted);
			}

			main {
				min-height: calc(100vh - 200px);
			}

			.site-footer {
				background: var(--color-bg);
			}

			.footer-frame {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 var(--spacing-lg);
				border-inline: 1px dashed var(--color-border);
				border-top: 1px dashed var(--color-border);
			}

			.footer-content {
				display: grid;
				grid-template-columns: 2fr 1fr 1fr;
			}

			.footer-cell {
				padding: var(--spacing-xl) var(--spacing-lg);
				border-left: 1px dashed var(--color-border);
			}

			.footer-cell:first-child {
				padding-left: 0;
				border-left: none;
			}

			.footer-label {
				display: block;
				font-size: var(--font-size-xs);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				color: var(--color-muted);
				margin-bottom: var(--spacing-sm);
			}

			.footer-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-lg);
				font-weight: var(--font-weight-heading);
				text-transform: uppercase;
				color: var(--color-brand);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-xs);
			}

			.theme-switcher {
				display: flex;
				gap: var(--spacing-xs);
			}

			.theme-btn {
				background: transparent;
				border: 1px solid var(--color-border);
				color: var(--color-muted);
				font-family: var(--font-body);
				font-size: var(--font-size-xs);
				padding: var(--spacing-xs) var(--spacing-sm);
				border-radius: var(--radius);
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
				border-color: var(--color-text);
			}

			.theme-btn.active {
				background: var(--color-brand);
				color: var(--color-on-brand);
				border-color: var(--color-brand);
			}

			.footer-powered a {
				font-size: var(--font-size-sm);
				color: var(--color-text);
				text-decoration: none;
				font-weight: 500;
			}

			.footer-powered a:hover {
				color: var(--color-brand);
			}

			@media (max-width: 900px) {
				.nav-frame {
					padding: 0 var(--spacing-md);
				}

				.nav-link {
					padding: var(--spacing-sm) var(--spacing-sm);
				}

				.footer-content {
					grid-template-columns: 1fr;
				}

				.footer-cell {
					border-left: none;
					border-top: 1px dashed var(--color-border);
					padding: var(--spacing-lg) 0;
				}

				.footer-cell:first-child {
					border-top: none;
				}
			}

			@media (max-width: 640px) {
				.nav {
					flex-wrap: wrap;
				}

				.nav-links {
					flex-wrap: wrap;
					border-left: none;
					width: 100%;
				}

				h1 {
					font-size: var(--font-size-3xl);
				}
			}
		</style>
	</body>
</html>
