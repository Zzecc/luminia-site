---
export const prerender = false;

import { getEmDashCollection, getTaxonomyTerms, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("blog", {
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const sections = await getTaxonomyTerms("section", { includeCounts: false });

const postIds = posts.map((p) => p.data.id);
const [sectionsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("blog", postIds, "section"),
	getTermsForEntries("blog", postIds, "post_tag"),
]);

const postsWithTerms = posts.map((post) => ({
	post,
	sections: sectionsByEntry.get(post.data.id) ?? [],
	tags: tagsByEntry.get(post.data.id) ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Blog" description="Petro, corrupción, izquierda: notas y artículos.">
	<section class="blog-header">
		<h1>Blog</h1>
		{
			sections.length > 0 && (
				<nav class="section-filters" aria-label="Secciones">
					{sections.map((s) => (
						<a href={`/blog/section/${s.slug}`} class="section-chip">
							{s.label}
						</a>
					))}
				</nav>
			)
		}
	</section>

	{
		posts.length === 0 ? (
			<p class="empty">Aún no hay publicaciones.</p>
		) : (
			<div class="posts-list">
				{postsWithTerms.map(({ post, sections: postSections, tags }) => (
					<article class="post-item">
						<a href={`/blog/${post.id}`} class="post-link">
							<div class="post-meta">
								{postSections.map((s) => (
									<span class="section-badge">{s.label}</span>
								))}
								{post.data.publishedAt && (
									<time class="post-date">{formatDate(post.data.publishedAt)}</time>
								)}
							</div>
							<h2 class="post-title">{post.data.title}</h2>
							{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
						</a>
						{
							tags.length > 0 && (
								<div class="post-tags">
									{tags.map((t) => (
										<span class="post-tag">{t.label}</span>
									))}
								</div>
							)
						}
					</article>
				))}
			</div>
		)
	}
</Base>

<style>
	.blog-header {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.blog-header h1 {
		font-family: var(--font-heading);
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-lg);
	}

	.section-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.section-chip {
		display: inline-block;
		padding: var(--spacing-xs) var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.section-chip:hover {
		color: var(--color-text);
		border-color: var(--color-text);
	}

	.empty {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
		color: var(--color-muted);
	}

	.posts-list {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
		display: flex;
		flex-direction: column;
	}

	.post-item {
		padding: var(--spacing-xl) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-sm);
	}

	.section-badge {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
		font-weight: 600;
	}

	.post-date {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		margin-top: var(--spacing-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
	}

	.post-tag {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		padding: var(--tag-padding-y, 2px) var(--spacing-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}
</style>
