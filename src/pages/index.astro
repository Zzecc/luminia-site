---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";

const SECTIONS = [
	{ collection: "petro", label: "Petro", href: "/petro" },
	{ collection: "corrupcion", label: "Corrupción", href: "/corrupcion" },
	{ collection: "izquierda", label: "Izquierda", href: "/izquierda" },
] as const;

// Each content type is its own collection/table, so the combined "latest
// posts" feed on the home page is a fan-out query — one small, limited
// fetch per collection, merged and re-sorted in JS — rather than a single
// query across tables.
const [settings, ...perSection] = await Promise.all([
	getSiteSettings(),
	...SECTIONS.map((s) => getEmDashCollection(s.collection, { orderBy: { published_at: "desc" }, limit: 5 })),
]);

for (const { cacheHint } of perSection) {
	if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
}

const latestPosts = perSection
	.flatMap((result, i) =>
		result.entries.map((post) => ({ post, section: SECTIONS[i] })),
	)
	.filter(({ post }) => post.data.publishedAt)
	.sort((a, b) => b.post.data.publishedAt!.getTime() - a.post.data.publishedAt!.getTime())
	.slice(0, 7);

const [featuredPost, ...restPosts] = latestPosts;

const formatDate = (date: Date) =>
	date.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
---

<Base>
	<section class="hero">
		<h1 class="hero-title">{settings?.title || "Sitio"}</h1>
		<p class="hero-tagline">{settings?.tagline || ""}</p>
		<nav class="section-filters" aria-label="Secciones">
			{SECTIONS.map((s) => (
				<a href={s.href} class="section-chip">
					{s.label}
				</a>
			))}
		</nav>
	</section>

	{
		featuredPost && (
			<section class="hero-post">
				<a href={`${featuredPost.section.href}/${featuredPost.post.id}`} class="hero-post-link">
					{featuredPost.post.data.featured_image && (
						<div class="hero-post-image">
							<Image image={featuredPost.post.data.featured_image} />
						</div>
					)}
					<div class="hero-post-body">
						<div class="post-meta">
							<span class="type-badge">{featuredPost.section.label}</span>
							{featuredPost.post.data.publishedAt && (
								<time class="post-date">{formatDate(featuredPost.post.data.publishedAt)}</time>
							)}
						</div>
						<h2 class="hero-post-title">{featuredPost.post.data.title}</h2>
						{featuredPost.post.data.excerpt && (
							<p class="hero-post-excerpt">{featuredPost.post.data.excerpt}</p>
						)}
					</div>
				</a>
			</section>
		)
	}

	{
		restPosts.length > 0 && (
			<section class="featured">
				<header class="section-header">
					<h2 class="section-title">Más publicaciones</h2>
				</header>
				<div class="posts-list">
					{restPosts.map(({ post, section }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image ?? undefined}
							href={`${section.href}/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							typeLabel={section.label}
						/>
					))}
				</div>
			</section>
		)
	}

	{
		!featuredPost && (
			<section class="empty-state">
				<h2>Aún no hay publicaciones</h2>
				<p>Agrega tu primera publicación en el panel de administración.</p>
			</section>
		)
	}
</Base>

<style>
	.hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-2xl);
		text-align: center;
	}

	.hero-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-md);
		letter-spacing: var(--tracking-tight);
	}

	.hero-tagline {
		font-size: var(--font-size-xl);
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-style: italic;
	}

	.section-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-xl);
	}

	.section-chip {
		display: inline-block;
		padding: var(--spacing-xs) var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.section-chip:hover {
		color: var(--color-text);
		border-color: var(--color-text);
	}

	.hero-post {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-3xl);
	}

	.hero-post-link {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: var(--spacing-2xl);
		align-items: center;
		text-decoration: none;
		color: inherit;
	}

	.hero-post-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.hero-post-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-slow, 400ms ease);
	}

	.hero-post-link:hover .hero-post-image :global(img) {
		transform: scale(1.02);
	}

	.hero-post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		margin-top: var(--spacing-sm);
		transition: color var(--transition-fast);
	}

	.hero-post-link:hover .hero-post-title {
		color: var(--color-brand);
	}

	.hero-post-excerpt {
		margin-top: var(--spacing-md);
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.type-badge {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
		font-weight: 600;
	}

	.post-date {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.featured {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
	}

	.section-header {
		margin-bottom: var(--spacing-2xl);
		padding-bottom: var(--spacing-md);
		border-bottom: 1px solid var(--color-border);
	}

	.section-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl) var(--spacing-lg);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-sm);
	}

	.empty-state p {
		color: var(--color-muted);
	}

	@media (max-width: 768px) {
		.hero {
			padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-xl);
		}

		.hero-title {
			font-size: var(--font-size-3xl);
		}

		.hero-post-link {
			grid-template-columns: 1fr;
		}

		.hero-post-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
